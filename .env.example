# Copy this file to .env and fill in your real values. .env is gitignored — never commit it.

# --- DagsHub (hosts your MLflow tracking server) ---
# Found on your DagsHub repo page under "Remote" -> "Experiments" -> mlflow tracking URI
MLFLOW_TRACKING_URI=https://dagshub.com/<your-dagshub-username>/loan-default-mlops.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
# Generate at: DagsHub -> profile icon -> Settings -> Tokens -> Generate New Token
MLFLOW_TRACKING_PASSWORD=<your-dagshub-access-token>

# --- Hugging Face Hub (optional second model registry) ---
# If unset, src/train.py skips the Hugging Face push and trains/registers as normal.
# Generate a token at: huggingface.co -> Settings -> Access Tokens (needs "Write" scope)
HF_TOKEN=<your-huggingface-access-token>
HF_REPO_ID=<your-huggingface-username>/loan-default-classifier
