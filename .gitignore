# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# Virtual environment
venv/
.venv/

# Environment secrets
.env

# Data (DVC-tracked, not git-tracked)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models (DVC-tracked, not git-tracked)
models/*.pkl
models/*.joblib
!models/.gitkeep

# MLflow / DVC local artifacts
mlruns/
mlartifacts/
.dvc/cache/
.dvc/tmp/

# Reports generated by the pipeline
reports/*.png
reports/*.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
